# Copy to .env and fill in. Never commit .env.
DEBUG=True
SECRET_KEY=change-this-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Project-owned Postgres container (docker-compose.yml)
DATABASE_NAME=rag_evaluation_db
DATABASE_USER=rag_user
DATABASE_PASSWORD=change_this_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434

# Shared Redis: databases 0-2 and 5-7 belong to other projects
CELERY_BROKER_URL=redis://127.0.0.1:6379/8
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/9
CACHE_URL=redis://127.0.0.1:6379/10

MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=rageval
MINIO_SECRET_KEY=change_this_password
MINIO_BUCKET=rag-eval-documents

QDRANT_URL=http://127.0.0.1:6333

# BM25 backend: "opensearch", or "local" (in-process Okapi BM25 over Postgres chunks)
BM25_BACKEND=local
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USER=rag_eval
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=False

OLLAMA_BASE_URL=http://127.0.0.1:11434
# How long Ollama keeps the model in RAM after a call. Short, because this machine has 7.5 GB.
OLLAMA_KEEP_ALIVE=30s
LLM_TIMEOUT_SECONDS=300
# LLM working memory and CPU threads. Lower them if the machine runs out of memory.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=4
ML_THREADS=4

NLI_MODEL=cross-encoder/nli-MiniLM2-L6-H768
# Set to 1 after the first run has downloaded the models.
HF_HUB_OFFLINE=0

# Optional. Tracing stays off until both keys are set.
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Passwords for accounts created by `manage.py seed_demo`
DEMO_ADMIN_PASSWORD=change_this_password
DEMO_USER_PASSWORD=change_this_password
